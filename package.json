{
  "name": "takahashi-presenter",
  "version": "1.0.0",
  "description": "A minimalist presentation tool that embodies the Takahashi Method",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "presentation",
    "takahashi",
    "slides"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "js/**/*.js",
      "!js/tests/**"
    ]
  }
}
